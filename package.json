{
  "name": "rebuttal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "hero": "tsx eval/hero.ts",
    "sandbox:order": "tsx --env-file=.env scripts/sandbox-order.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "test:sandbox": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts",
    "chaos": "tsx scripts/chaos/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
