{
  "name": "rebuttal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "hero": "tsx --env-file-if-exists=.env eval/hero.ts",
    "sandbox:order": "tsx --env-file=.env scripts/sandbox-order.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "test:sandbox": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts",
    "chaos": "tsx scripts/chaos/run.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "eval": "tsx --env-file-if-exists=.env eval/runner.ts",
    "e2e": "playwright test",
    "record:chat": "tsx --env-file-if-exists=.env scripts/record-chat.ts"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^13.5.1",
    "next": "^16.4.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
