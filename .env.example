# Copy to .env and fill in. NEVER commit .env.
# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the sandbox app's Webhooks section; used to verify deliveries
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account email, used by spike scripts
PAYPAL_BUYER_EMAIL=

# Turns on sandbox-only simulator actions (require-evidence, adjudicate). Must be false/absent anywhere real.
SANDBOX_SIMULATOR=true

# App LLM key. Keep this exact name; do not reuse a provider SDK's default variable name.
REBUTTAL_LLM_KEY=
# Comma list for fallback on 429, e.g. gemini,groq. Fallbacks read REBUTTAL_LLM_KEY_<NAME> and REBUTTAL_LLM_MODEL_<NAME>.
REBUTTAL_LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-2.5-flash, openai/gpt-oss-120b)
REBUTTAL_LLM_MODEL=
REBUTTAL_LLM_KEY_GROQ=
# record = save responses, replay = use saved responses only, live = always call the model
REBUTTAL_LLM_MODE=record

# Database (Render Postgres in production)
DATABASE_URL=

# Fault injection for the chaos script: crash_after_send | crash_before_confirm | timeout
FAULT=

# Cost and abuse limits for the public demo
DAILY_LLM_CALL_CAP=200
# Judges get this many "Run demo" clicks per hour per IP (the IP is stored only as a salted hash)
PER_IP_RUNS_PER_HOUR=20
RATE_LIMIT_SALT=
# Seller password for the Approve / Reject buttons on /desk. Unset = approvals disabled on this deploy.
DESK_APPROVER_TOKEN=

# Evidence ledger: base64 PKCS#8 DER of an Ed25519 private key. Unset = /verify shows the chain head unsigned. Make one with:
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
LEDGER_SIGNING_KEY=

# AG Studio licence key for /dashboard (optional: without it AG Studio runs unlicensed). Free 45-day trial at ag-grid.com/studio.
AG_STUDIO_LICENSE_KEY=
