# Copy to .env and fill in. NEVER commit .env.
# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the sandbox app's Webhooks section; used to verify deliveries
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account email, used by spike scripts
PAYPAL_BUYER_EMAIL=

# Turns on sandbox-only simulator actions (require-evidence, adjudicate). Must be false/absent anywhere real.
SANDBOX_SIMULATOR=true

# App LLM key. NEVER name it ANTHROPIC_API_KEY (Claude Code would bill the API instead of your subscription).
REBUTTAL_LLM_KEY=
REBUTTAL_LLM_PROVIDER=gemini
# record = save responses, replay = use saved responses only, live = always call the model
REBUTTAL_LLM_MODE=record

# Database (Render Postgres in production)
DATABASE_URL=

# Fault injection for the chaos script: crash_after_send | crash_before_confirm | timeout
FAULT=

# Cost and abuse limits for the public demo
DAILY_LLM_CALL_CAP=200
PER_IP_RUNS_PER_HOUR=5
